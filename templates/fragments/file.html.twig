{% set isParentDirectory = file.name == '..' %}

{% if isParentDirectory %}
    {% set icon = 'parent-directory' %}
    {% set name = 'files.parentDirectory'|trans %}
    {% set path = file.canonicalizedPath %}
{% else %}
    {% set icon = file_icon(file) %}
    {% set name = file.name %}
    {% set path = file.path %}
{% endif %}

{% set encodedPath = base64_encode(path) %}

<tr class="file" id="file-{{ encodedPath }}" data-name="{{ base64_encode(name) }}" {% if file.isFile %}data-mime="{{ file.mimeType }}"{% endif %}>
    <td class="file-icon" aria-label="{{ ('files.icon.' ~ icon)|trans }}">
        {{ icon(icon) }}
    </td>
    <td class="file-name text-col text-left">
        <a class="file-link" href="{{ path(file.isFile ? 'downloadFile' : 'listFiles', { path: path }) }}" title="{{ name }}">{{ name }}</a>
    </td>
    <td class="file-size">
        {% if file.isFile %}
            {{ format_bytes(file.size) }}
        {% endif %}
    </td>
    <td class="file-buttons">
        {% if not isParentDirectory %}
            <button class="icon-only" popovertarget="file-dropdown-{{ encodedPath }}" aria-label="{{ 'files.actions'|trans }}">
                {{ icon('ellipsis') }}
            </button>
            {#- -#}
            <ul id="file-dropdown-{{ encodedPath }}" class="dropdown-menu file-dropdown" popover>
                {% if file.isDirectory %}
                    <li>
                        <a class="button open-file" href="{{ path('listFiles', { path: path }) }}">
                            {{ icon('open') }}{{ 'files.open'|trans }}
                        </a>
                    </li>
                {% endif %}

                <li>
                    <a class="button download-file" href="{{ path('downloadFile', { path: path }) }}">
                        {{ icon('download') }}{{ 'files.download'|trans }}
                    </a>
                </li>
                {% if file.isFile %}
                    {% if file.isPlayable %}
                        <li class="play-item">
                            <a class="button play-file" href="{{ path('playFile', { path: path }) }}">
                                {{ icon('play') }}{{ 'files.play'|trans }}
                            </a>
                        </li>
                    {% elseif file.isDisplayable %}
                        <li>
                            <a class="button display-file" href="{{ path('displayFile', { path: path }) }}">
                                {{ icon('display') }}{{ 'files.display'|trans }}
                            </a>
                        </li>
                    {% endif %}
                {% endif %}
                {% if file.isSharable %}
                    <li>
                        <hr/>
                    </li>
                    {% if file.isShared %}
                        <li>
                            <a href="{{ url('sharedFiles_listFiles', { id: file.sharingId }) }}" class="button sharing-link">
                                {{ icon('link') }}{{ 'files.sharingLink'|trans }}
                            </a>
                        </li>
                        <li>
                            <button class="sharing-remove" id="sharing-{{ file.sharingId }}">
                                {{ icon('unlink') }}{{ 'files.removeSharing'|trans }}
                            </button>
                        </li>
                    {% else %}
                        <li>
                            <button class="add-sharing">
                                {{ icon('link') }}{{ 'files.share'|trans }}
                            </button>
                        </li>
                    {% endif %}
                {% endif %}
            </ul>

            {%- if file.isFilesystemWritable -%}
                <button class="icon-only danger file-remove" aria-label="{{ 'files.remove'|trans }}" {% if not file.isDeletable %}disabled{% endif %}>
                    {{ icon('close') }}
                </button>
            {% endif %}
        {% endif %}
    </td>
</tr>
